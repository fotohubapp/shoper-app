# --- Shoper store -----------------------------------------------------
# Store URL, e.g. https://sklep123456.shoparena.pl or a custom domain
SHOPER_STORE_URL=

# EITHER a permanent webapi access token (private app):
SHOPER_ACCESS_TOKEN=

# OR webapi user login/password (the app obtains and refreshes the bearer
# token via POST {store}/webapi/rest/auth automatically):
SHOPER_LOGIN=
SHOPER_PASSWORD=

# --- FOTOhub ------------------------------------------------------------
# API key from https://fotohub.app -> Console -> API Keys
FOTOHUB_API_KEY=

# Passphrase encrypting the local secret store (SQLite). Use a long random
# value in production.
FOTOHUB_CONFIG_SECRET=

# --- Server ---------------------------------------------------------------
PORT=8811
# Bind address; keep 127.0.0.1 behind a reverse proxy, 0.0.0.0 in Docker.
HOST=127.0.0.1
# Publicly reachable base URL of this app (enables bridge webhook callbacks):
PUBLIC_URL=
# Where the SQLite database lives (drafts, job cache, encrypted config):
DATA_DIR=./data
